@model List<AarMaabd.Models.CustomOrderRequest>
@{
    ViewData["Title"] = "Custom Order Requests";
}

<div class="mb-4">
    <h1 class="h3 fw-bold mb-1" style="color: var(--brand-rose);">Custom Handmade Requests</h1>
    <p class="text-muted small mb-0">Customer requests for bespoke crochet pieces, personalized cakes, and resin gifts.</p>
</div>

<div class="admin-card">
    @if (!Model.Any())
    {
        <div class="text-center py-5 text-muted small">No custom requests submitted yet.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead class="table-light small text-uppercase text-muted">
                    <tr>
                        <th>Req #</th>
                        <th>Date</th>
                        <th>Customer</th>
                        <th>Category</th>
                        <th>Needed By</th>
                        <th>Budget</th>
                        <th>Status</th>
                        <th class="text-end">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in Model)
                    {
                        <tr>
                            <td><strong>#@r.Id</strong></td>
                            <td class="small text-muted">@r.CreatedAtUtc.ToLocalTime().ToString("dd MMM yyyy")</td>
                            <td>
                                <div class="fw-semibold">@r.CustomerName</div>
                                <small class="text-muted">@r.CustomerPhone</small>
                            </td>
                            <td><span class="badge bg-light text-dark border">@r.Category</span></td>
                            <td class="small">@(r.TargetDeliveryDate.HasValue ? r.TargetDeliveryDate.Value.ToString("dd MMM yyyy") : "Flexible")</td>
                            <td class="small">@(r.EstimatedBudget.HasValue ? $"৳{r.EstimatedBudget.Value:N0}" : "Unspecified")</td>
                            <td>
                                <span class="badge @(r.Status == AarMaabd.Models.CustomOrderStatus.Completed ? "bg-success" : "bg-warning text-dark") rounded-pill">
                                    @r.Status
                                </span>
                            </td>
                            <td class="text-end">
                                <a asp-action="Details" asp-route-id="@r.Id" class="btn btn-sm btn-outline-primary rounded-pill">
                                    Review & Quote
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@model AarMaabd.Models.Category
@{
    ViewData["Title"] = $"Edit Category - {Model.Name}";
}

<div class="mb-4">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
        <div>
            <h1 class="h3 fw-bold mb-1" style="color: var(--brand-rose);">Edit Category</h1>
            <p class="text-muted small mb-0">Update category details, card image, and menu status.</p>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm rounded-pill px-3">
            <i class="bi bi-arrow-left me-1"></i> Back to Categories
        </a>
    </div>
</div>

<div class="admin-card" style="max-width: 650px;">
    <form asp-action="Edit" asp-route-id="@Model.Id" method="post" enctype="multipart/form-data">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="ImageUrl" />

        <div class="mb-3">
            <label asp-for="Name" class="form-label small fw-bold text-uppercase">Category Name *</label>
            <input asp-for="Name" class="form-control rounded-3" placeholder="e.g. Handmade Crochet Wear" required />
            <span asp-validation-for="Name" class="text-danger small"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Slug" class="form-label small fw-bold text-uppercase">Slug (URL)</label>
            <input asp-for="Slug" class="form-control rounded-3" placeholder="e.g. handmade-crochet-wear (auto-generated if empty)" />
            <span asp-validation-for="Slug" class="text-danger small"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Description" class="form-label small fw-bold text-uppercase">Description</label>
            <textarea asp-for="Description" rows="2" class="form-control rounded-3" placeholder="Brief summary for catalog header..."></textarea>
            <span asp-validation-for="Description" class="text-danger small"></span>
        </div>

        <div class="mb-3">
            <label class="form-label small fw-bold text-uppercase">Category Card Image</label>
            @if (!string.IsNullOrEmpty(Model.ImageUrl))
            {
                <div class="mb-2 d-flex align-items-center gap-3 p-2 bg-light rounded-3 border">
                    <img src="@Model.ImageUrl" alt="@Model.Name" class="rounded-2 border" style="width: 50px; height: 50px; object-fit: cover;" />
                    <div class="small">
                        <span class="text-muted d-block" style="font-size: 0.75rem;">Current Image</span>
                        <code class="text-truncate d-block" style="max-width: 320px;">@Model.ImageUrl</code>
                    </div>
                </div>
            }
            <input type="file" name="newImage" class="form-control rounded-3" accept=".jpg,.jpeg,.png,.webp" />
            <small class="text-muted d-block mt-1" style="font-size: 0.75rem;">Choose a new image to replace the existing one (optional).</small>
        </div>

        <div class="row g-2 mb-3">
            <div class="col-6">
                <label asp-for="DisplayOrder" class="form-label small fw-bold text-uppercase">Display Order</label>
                <input asp-for="DisplayOrder" class="form-control rounded-3" />
                <span asp-validation-for="DisplayOrder" class="text-danger small"></span>
            </div>
            <div class="col-6 d-flex align-items-end">
                <div class="form-check mb-2">
                    <input asp-for="IsActive" class="form-check-input" />
                    <label asp-for="IsActive" class="form-check-label small fw-bold">Active in Menu</label>
                </div>
            </div>
        </div>

        <div class="pt-3 border-top d-flex gap-2">
            <button type="submit" class="btn-aarmaabd px-4">
                <i class="bi bi-check-circle me-1"></i> Update Category
            </button>
            <a asp-action="Index" class="btn btn-light rounded-pill px-4">Cancel</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

@model List<AarMaabd.Models.Product>
@{
    ViewData["Title"] = "Manage Products";
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h1 class="h3 fw-bold mb-1" style="color: var(--brand-rose);">Products & Inventory</h1>
        <p class="text-muted small mb-0">Manage handcrafted items, stock levels, and promotional flags.</p>
    </div>
    <a asp-action="Create" class="btn-aarmaabd">
        <i class="bi bi-plus-circle me-1"></i> Add New Product
    </a>
</div>

<!-- Filters Bar -->
<div class="admin-card mb-4 p-3">
    <form method="get" class="row g-2 align-items-center">
        <div class="col-md-5">
            <input type="text" name="search" class="form-control form-control-sm rounded-pill" 
                   placeholder="Search product name or SKU..." value="@ViewBag.Search" />
        </div>
        <div class="col-md-4">
            <select name="categoryId" class="form-select form-select-sm rounded-pill" asp-items="ViewBag.Categories">
                <option value="">All Categories</option>
            </select>
        </div>
        <div class="col-md-3">
            <button type="submit" class="btn btn-sm btn-outline-secondary rounded-pill w-100">
                <i class="bi bi-filter me-1"></i> Filter Products
            </button>
        </div>
    </form>
</div>

<!-- Products Table -->
<div class="admin-card">
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead class="table-light small text-uppercase text-muted">
                <tr>
                    <th>Product</th>
                    <th>SKU</th>
                    <th>Category</th>
                    <th>Price</th>
                    <th>Stock</th>
                    <th>Type</th>
                    <th>Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in Model)
                {
                    <tr>
                        <td>
                            <div class="d-flex align-items-center gap-2">
                                <img src="@p.PrimaryImageUrl" alt="@p.Name" class="rounded-2 border" style="width: 44px; height: 44px; object-fit: cover;" />
                                <div>
                                    <strong class="d-block text-dark small">@p.Name</strong>
                                    @if (p.IsFeatured)
                                    {
                                        <span class="badge bg-warning-subtle text-warning-emphasis" style="font-size: 0.65rem;">Featured</span>
                                    }
                                </div>
                            </div>
                        </td>
                        <td class="small font-monospace">@p.SKU</td>
                        <td class="small text-muted">@(p.Category?.Name ?? "N/A")</td>
                        <td>
                            <strong style="color: var(--brand-rose);">৳@p.CurrentEffectivePrice.ToString("N0")</strong>
                            @if (p.HasDiscount)
                            {
                                <small class="text-muted text-decoration-line-through d-block">৳@p.Price.ToString("N0")</small>
                            }
                        </td>
                        <td>
                            <span class="badge @(p.StockQuantity <= p.LowStockThreshold ? "bg-danger-subtle text-danger" : "bg-success-subtle text-success") rounded-pill">
                                @p.StockQuantity units
                            </span>
                        </td>
                        <td>
                            <span class="badge bg-light text-dark border small">@p.ProductType</span>
                        </td>
                        <td>
                            <span class="badge @(p.IsActive ? "bg-success" : "bg-secondary") rounded-pill">
                                @(p.IsActive ? "Active" : "Archived")
                            </span>
                        </td>
                        <td class="text-end">
                            <div class="d-inline-flex gap-1">
                                <a asp-action="Edit" asp-route-id="@p.Id" class="btn btn-sm btn-outline-primary rounded-pill" title="Edit">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <form asp-action="ToggleStatus" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@p.Id" />
                                    <button type="submit" class="btn btn-sm @(p.IsActive ? "btn-outline-danger" : "btn-outline-success") rounded-pill" title="@(p.IsActive ? "Archive" : "Activate")">
                                        <i class="bi @(p.IsActive ? "bi-archive" : "bi-check2")"></i>
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@model AarMaabd.Models.Coupon
@{
    ViewData["Title"] = "Create Coupon Code";
}

<div class="mb-4">
    <div class="d-flex justify-content-between align-items-center">
        <div>
            <h1 class="h3 fw-bold mb-1" style="color: var(--brand-rose);">Create Coupon Code</h1>
            <p class="text-muted small mb-0">Configure discount value, minimum cart spend, and redemption rules.</p>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm rounded-pill">
            <i class="bi bi-arrow-left me-1"></i> Back to Coupons
        </a>
    </div>
</div>

<div class="admin-card" style="max-width: 750px;">
    <form asp-action="Create" method="post">
        @Html.AntiForgeryToken()

        <div class="row g-3">
            <div class="col-md-6">
                <label asp-for="Code" class="form-label small fw-bold text-uppercase">Coupon Code *</label>
                <input asp-for="Code" class="form-control rounded-3 font-monospace fw-bold" placeholder="e.g. EID20 or AAR10" required />
                <span asp-validation-for="Code" class="text-danger small"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="DiscountType" class="form-label small fw-bold text-uppercase">Discount Type *</label>
                <select asp-for="DiscountType" class="form-select rounded-3">
                    <option value="@AarMaabd.Models.DiscountType.Percentage">Percentage (%)</option>
                    <option value="@AarMaabd.Models.DiscountType.FixedAmount">Fixed Amount (৳ BDT)</option>
                </select>
            </div>

            <div class="col-md-4">
                <label asp-for="DiscountValue" class="form-label small fw-bold text-uppercase">Discount Value *</label>
                <input asp-for="DiscountValue" type="number" min="0" step="0.01" class="form-control rounded-3" placeholder="e.g. 10 or 150" required />
                <span asp-validation-for="DiscountValue" class="text-danger small"></span>
            </div>

            <div class="col-md-4">
                <label asp-for="MaxDiscountCap" class="form-label small fw-bold text-uppercase">Max Discount Cap (৳ Optional)</label>
                <input asp-for="MaxDiscountCap" type="number" min="0" step="0.01" class="form-control rounded-3" placeholder="e.g. 300" />
                <span asp-validation-for="MaxDiscountCap" class="text-danger small"></span>
            </div>

            <div class="col-md-4">
                <label asp-for="MinSpendAmount" class="form-label small fw-bold text-uppercase">Min Spend (৳) *</label>
                <input asp-for="MinSpendAmount" type="number" min="0" step="0.01" class="form-control rounded-3" value="500" required />
                <span asp-validation-for="MinSpendAmount" class="text-danger small"></span>
            </div>

            <div class="col-12">
                <label asp-for="Description" class="form-label small fw-bold text-uppercase">Customer Description</label>
                <input asp-for="Description" class="form-control rounded-3" placeholder="e.g. 10% OFF on all handcrafted items above ৳500" />
            </div>

            <div class="col-md-6">
                <label asp-for="StartDateUtc" class="form-label small fw-bold text-uppercase">Start Date *</label>
                <input asp-for="StartDateUtc" class="form-control rounded-3" type="date" />
            </div>

            <div class="col-md-6">
                <label asp-for="EndDateUtc" class="form-label small fw-bold text-uppercase">Expiry Date *</label>
                <input asp-for="EndDateUtc" class="form-control rounded-3" type="date" />
            </div>

            <div class="col-md-6">
                <label asp-for="UsageLimitTotal" class="form-label small fw-bold text-uppercase">Total Redemptions Limit</label>
                <input asp-for="UsageLimitTotal" type="number" min="0" step="1" class="form-control rounded-3" value="100" />
                <span asp-validation-for="UsageLimitTotal" class="text-danger small"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="UsageLimitPerCustomer" class="form-label small fw-bold text-uppercase">Per Customer Limit</label>
                <input asp-for="UsageLimitPerCustomer" type="number" min="0" step="1" class="form-control rounded-3" value="1" />
                <span asp-validation-for="UsageLimitPerCustomer" class="text-danger small"></span>
            </div>

            <div class="col-12">
                <div class="form-check mt-2">
                    <input asp-for="IsActive" class="form-check-input" checked />
                    <label asp-for="IsActive" class="form-check-label small fw-bold">Active Immediately</label>
                </div>
            </div>
        </div>

        <div asp-validation-summary="ModelOnly" class="alert alert-danger small p-2 rounded-3 mt-3 mb-3"></div>

        <div class="mt-4 pt-3 border-top d-flex gap-2">
            <button type="submit" class="btn-aarmaabd px-4">
                <i class="bi bi-check-circle me-1"></i> Save Coupon
            </button>
            <a asp-action="Index" class="btn btn-light rounded-pill px-4">Cancel</a>
        </div>
    </form>
</div>

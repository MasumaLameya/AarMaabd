<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - AarMaabd Admin</title>

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <!-- Bootstrap 5 & Icons -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <style>
        body {
            background-color: #F8F9FA;
            font-family: 'Plus Jakarta Sans', sans-serif;
        }
        .admin-sidebar {
            width: 250px;
            background: #FFFFFF;
            border-right: 1px solid var(--border-soft);
            min-height: 100vh;
        }
        .admin-nav-link {
            padding: 10px 20px;
            display: flex;
            align-items: center;
            gap: 12px;
            color: #4A454B;
            font-weight: 500;
            text-decoration: none;
            border-left: 3px solid transparent;
            transition: all var(--transition-fast);
        }
        .admin-nav-link:hover, .admin-nav-link.active {
            background-color: var(--brand-blush-light);
            color: var(--brand-rose);
            border-left-color: var(--brand-rose);
            font-weight: 600;
        }
    </style>
</head>
<body>
    <!-- Admin Topbar -->
    <header class="navbar navbar-expand navbar-light bg-white border-bottom sticky-top px-3 py-2 shadow-sm">
        <a class="navbar-brand d-flex align-items-center gap-2" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">
            <img src="~/images/branding/logo.jpg" alt="Logo" style="width: 36px; height: 36px; border-radius: 50%;" />
            <strong style="color: var(--brand-rose);">AarMaabd Admin</strong>
        </a>

        <div class="ms-auto d-flex align-items-center gap-3">
            <a href="/" target="_blank" class="btn btn-sm btn-outline-secondary rounded-pill">
                <i class="bi bi-box-arrow-up-right me-1"></i> View Live Store
            </a>
            <div class="dropdown">
                <button class="btn btn-sm btn-light rounded-pill dropdown-toggle fw-semibold" type="button" data-bs-toggle="dropdown">
                    <i class="bi bi-person-circle me-1"></i> Admin
                </button>
                <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0">
                    <li><a class="dropdown-item" href="/">Go to Storefront</a></li>
                    <li><hr class="dropdown-divider"></li>
                    <li>
                        <form asp-area="" asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                            <button type="submit" class="dropdown-item text-danger">Sign Out</button>
                        </form>
                    </li>
                </ul>
            </div>
        </div>
    </header>

    <div class="d-flex">
        <!-- Admin Sidebar -->
        <nav class="admin-sidebar d-none d-md-block">
            <div class="py-3">
                <small class="text-uppercase text-muted px-3 fw-bold" style="font-size: 0.75rem;">Main Navigation</small>
                <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index" class="admin-nav-link mt-2">
                    <i class="bi bi-speedometer2"></i> Dashboard
                </a>
                <a asp-area="Admin" asp-controller="Orders" asp-action="Index" class="admin-nav-link">
                    <i class="bi bi-bag-check"></i> Orders & Shipping
                </a>
                <a asp-area="Admin" asp-controller="Products" asp-action="Index" class="admin-nav-link">
                    <i class="bi bi-box-seam"></i> Products & Stock
                </a>
                <a asp-area="Admin" asp-controller="Categories" asp-action="Index" class="admin-nav-link">
                    <i class="bi bi-grid"></i> Categories
                </a>

                <small class="text-uppercase text-muted px-3 fw-bold d-block mt-4 mb-1" style="font-size: 0.75rem;">Promotions & CRM</small>
                <a asp-area="Admin" asp-controller="Coupons" asp-action="Index" class="admin-nav-link">
                    <i class="bi bi-ticket-perforated"></i> Coupon Codes
                </a>
                <a asp-area="Admin" asp-controller="Offers" asp-action="Index" class="admin-nav-link">
                    <i class="bi bi-tag"></i> 10%/20% Offers
                </a>
                <a asp-area="Admin" asp-controller="CustomOrders" asp-action="Index" class="admin-nav-link">
                    <i class="bi bi-palette"></i> Custom Requests
                </a>
            </div>
        </nav>

        <!-- Admin Content Area -->
        <main class="flex-grow-1 p-3 p-md-4" style="min-width: 0;">
            <partial name="_NotificationPartial" />
            @RenderBody()
        </main>
    </div>

    <!-- Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

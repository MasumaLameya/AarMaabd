@model AarMaabd.Models.Order
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>Invoice - @Model.OrderNumber</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <style>
        body { font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; color: #333; background: #fff; padding: 30px; }
        .invoice-box { max-width: 800px; margin: auto; padding: 20px; border: 1px solid #eee; box-shadow: 0 0 10px rgba(0, 0, 0, 0.05); }
        .brand-title { color: #753D51; font-weight: 700; font-size: 26px; }
        @@media print {
            .no-print { display: none !important; }
            body { padding: 0; }
            .invoice-box { border: none; box-shadow: none; }
        }
    </style>
</head>
<body>
    <div class="invoice-box">
        <div class="d-flex justify-content-between align-items-center mb-4 no-print">
            <button onclick="window.print()" class="btn btn-primary btn-sm">Print Invoice</button>
            <button onclick="window.close()" class="btn btn-outline-secondary btn-sm">Close</button>
        </div>

        <div class="d-flex justify-content-between align-items-center border-bottom pb-4 mb-4">
            <div>
                <div class="brand-title">AarMaabd</div>
                <small class="text-muted">Handmade With Love & Curated Lifestyle</small><br />
                <small class="text-muted">Dhanmondi, Dhaka, Bangladesh | +880 1700-000000</small>
            </div>
            <div class="text-end">
                <h4 class="mb-0 text-uppercase fw-bold text-muted">Invoice</h4>
                <div class="fw-bold">#@Model.OrderNumber</div>
                <small class="text-muted">Date: @Model.CreatedAtUtc.ToLocalTime().ToString("dd MMM yyyy")</small>
            </div>
        </div>

        <div class="row mb-4">
            <div class="col-6">
                <small class="text-uppercase fw-bold text-muted">Billed & Delivered To:</small>
                <div class="fw-bold">@Model.CustomerName</div>
                <div>@Model.StreetAddress, @Model.Area</div>
                <div>@Model.UpazilaThana, @Model.District, @Model.Division</div>
                <div>Phone: @Model.CustomerPhone</div>
            </div>
            <div class="col-6 text-end">
                <small class="text-uppercase fw-bold text-muted">Payment Details:</small>
                <div class="fw-bold">Method: @Model.PaymentMethod</div>
                <div>Status: @Model.PaymentStatus</div>
                @if (!string.IsNullOrEmpty(Model.PaymentTransactionId))
                {
                    <small class="text-muted">Trx ID: @Model.PaymentTransactionId</small>
                }
            </div>
        </div>

        <table class="table table-bordered mb-4">
            <thead class="table-light">
                <tr>
                    <th>Item Description</th>
                    <th class="text-center">Qty</th>
                    <th class="text-end">Unit Price</th>
                    <th class="text-end">Total</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Items)
                {
                    <tr>
                        <td>
                            <strong>@item.ProductNameSnapshot</strong>
                            @if (!string.IsNullOrEmpty(item.VariantNameSnapshot))
                            {
                                <small class="text-muted d-block">(@item.VariantNameSnapshot)</small>
                            }
                            @if (!string.IsNullOrEmpty(item.CustomizationNoteSnapshot))
                            {
                                <small class="text-muted d-block fst-italic">Note: @item.CustomizationNoteSnapshot</small>
                            }
                        </td>
                        <td class="text-center">@item.Quantity</td>
                        <td class="text-end">৳@item.UnitPriceSnapshot.ToString("N0")</td>
                        <td class="text-end">৳@item.LineTotal.ToString("N0")</td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr>
                    <th colspan="3" class="text-end">Subtotal:</th>
                    <td class="text-end">৳@Model.SubTotal.ToString("N0")</td>
                </tr>
                @if (Model.CouponDiscountAmount > 0)
                {
                    <tr>
                        <th colspan="3" class="text-end text-success">Coupon Discount (@Model.AppliedCouponCode):</th>
                        <td class="text-end text-success">-৳@Model.CouponDiscountAmount.ToString("N0")</td>
                    </tr>
                }
                <tr>
                    <th colspan="3" class="text-end">Delivery Charge (@Model.DeliveryZone):</th>
                    <td class="text-end">৳@Model.DeliveryFee.ToString("N0")</td>
                </tr>
                <tr>
                    <th colspan="3" class="text-end fs-5">Total Payable:</th>
                    <th class="text-end fs-5" style="color: #753D51;">৳@Model.TotalAmount.ToString("N0")</th>
                </tr>
            </tfoot>
        </table>

        <div class="text-center text-muted small pt-3 border-top">
            Thank you for shopping with AarMaabd! Handcrafted with love in Bangladesh.
        </div>
    </div>
</body>
</html>

@model AarMaabd.Models.CustomOrderRequest
@{
    ViewData["Title"] = "Request Received";
}

<div class="container py-5 text-center" style="max-width: 600px;">
    <div class="p-4 p-md-5 bg-white rounded-4 border shadow-sm">
        <div class="rounded-circle d-inline-flex align-items-center justify-content-center p-3 mb-3 shadow-sm" 
             style="background-color: #EBF7EE; color: #1E6B38; width: 70px; height: 70px; font-size: 2rem;">
            <i class="bi bi-check2-circle"></i>
        </div>

        <h1 class="h3 fw-bold mb-2" style="color: var(--brand-rose);">Custom Request #@Model.Id Received!</h1>
        <p class="text-muted small mb-4">
            Thank you, @Model.CustomerName! We have received your @Model.Category request. Our team will review your specifications and contact you on <strong>@Model.CustomerPhone</strong> with a detailed quotation and timeline.
        </p>

        <div class="p-3 bg-light rounded-3 text-start mb-4 small">
            <div><strong>Category:</strong> @Model.Category</div>
            <div><strong>Specifications:</strong> @Model.Description</div>
            @if (Model.EstimatedBudget.HasValue)
            {
                <div><strong>Estimated Budget:</strong> ৳@Model.EstimatedBudget.Value.ToString("N0")</div>
            }
        </div>

        <div class="d-flex gap-2 justify-content-center flex-wrap">
            <a href="/Shop" class="btn-aarmaabd">Continue Browsing</a>
            <a href="https://wa.me/8801700000000" target="_blank" class="btn btn-outline-success rounded-pill px-3 py-2 fw-semibold">
                <i class="bi bi-whatsapp me-1"></i> Follow up on WhatsApp
            </a>
        </div>
    </div>
</div>

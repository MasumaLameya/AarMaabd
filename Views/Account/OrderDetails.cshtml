@model AarMaabd.Models.Order
@{
    ViewData["Title"] = $"Order Details - {Model.OrderNumber}";
}

<div class="container py-4" style="max-width: 800px;">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 fw-bold mb-1" style="color: var(--brand-rose);">Order #@Model.OrderNumber</h1>
            <p class="text-muted small mb-0">Placed on @Model.CreatedAtUtc.ToLocalTime().ToString("dd MMMM yyyy, hh:mm tt")</p>
        </div>
        <a asp-action="Dashboard" class="btn btn-outline-secondary btn-sm rounded-pill">
            <i class="bi bi-arrow-left me-1"></i> Back to Dashboard
        </a>
    </div>

    <!-- Status Bar -->
    <div class="p-3 bg-white rounded-4 border shadow-sm mb-4 d-flex justify-content-between align-items-center flex-wrap gap-2">
        <div>
            <span class="text-muted small">Fulfillment Status:</span>
            <span class="badge @(Model.Status == AarMaabd.Models.OrderStatus.Delivered ? "bg-success-subtle text-success" : "bg-warning-subtle text-warning-emphasis") rounded-pill px-3 py-1 ms-1 fw-bold">
                @Model.Status
            </span>
        </div>
        <div>
            <span class="text-muted small">Payment:</span>
            <span class="badge @(Model.PaymentStatus == AarMaabd.Models.PaymentStatus.Paid ? "bg-success-subtle text-success" : "bg-secondary-subtle text-dark") rounded-pill px-3 py-1 ms-1 fw-bold">
                @Model.PaymentStatus (@Model.PaymentMethod)
            </span>
        </div>
    </div>

    <!-- Items List -->
    <div class="p-4 bg-white rounded-4 border shadow-sm mb-4">
        <h4 class="h6 fw-bold mb-3 border-bottom pb-2 text-uppercase text-muted">Ordered Items</h4>
        <div class="d-flex flex-column gap-3 mb-3">
            @foreach (var item in Model.Items)
            {
                <div class="d-flex align-items-center justify-content-between">
                    <div class="d-flex align-items-center gap-3">
                        <img src="@(string.IsNullOrEmpty(item.ImageUrlSnapshot) ? "/images/branding/logo.jpg" : item.ImageUrlSnapshot)" 
                             alt="@item.ProductNameSnapshot" class="rounded-2 border" style="width: 48px; height: 48px; object-fit: cover;" />
                        <div>
                            <strong class="d-block text-dark small">@item.ProductNameSnapshot</strong>
                            <small class="text-muted">Qty: @item.Quantity × ৳@item.UnitPriceSnapshot.ToString("N0")</small>
                            @if (!string.IsNullOrEmpty(item.CustomizationNoteSnapshot))
                            {
                                <small class="text-muted d-block fst-italic">"@item.CustomizationNoteSnapshot"</small>
                            }
                        </div>
                    </div>
                    <span class="fw-bold">৳@item.LineTotal.ToString("N0")</span>
                </div>
            }
        </div>

        <div class="border-top pt-3 small text-muted">
            <div class="d-flex justify-content-between py-1">
                <span>Subtotal:</span>
                <span class="text-dark fw-semibold">৳@Model.SubTotal.ToString("N0")</span>
            </div>
            @if (Model.OfferDiscountAmount > 0 || Model.CouponDiscountAmount > 0)
            {
                <div class="d-flex justify-content-between py-1 text-success">
                    <span>Discount:</span>
                    <span class="fw-bold">-৳@((Model.OfferDiscountAmount + Model.CouponDiscountAmount).ToString("N0"))</span>
                </div>
            }
            <div class="d-flex justify-content-between py-1">
                <span>Delivery Charge (@Model.DeliveryZone):</span>
                <span class="text-dark fw-semibold">৳@Model.DeliveryFee.ToString("N0")</span>
            </div>
            <div class="d-flex justify-content-between fs-5 fw-bold pt-2 mt-2 border-top" style="color: var(--brand-rose);">
                <span>Total Amount:</span>
                <span>৳@Model.TotalAmount.ToString("N0")</span>
            </div>
        </div>
    </div>

    <!-- Delivery Address Details -->
    <div class="p-4 bg-white rounded-4 border shadow-sm">
        <h4 class="h6 fw-bold mb-3 border-bottom pb-2 text-uppercase text-muted">Delivery Information</h4>
        <div class="small text-muted">
            <strong>Customer:</strong> @Model.CustomerName (@Model.CustomerPhone)<br />
            <strong>Address:</strong> @Model.StreetAddress, @Model.Area, @Model.UpazilaThana, @Model.District, @Model.Division<br />
            @if (!string.IsNullOrEmpty(Model.Landmark))
            {
                <span><strong>Landmark:</strong> @Model.Landmark<br /></span>
            }
            @if (Model.RequestedDeliveryDate.HasValue)
            {
                <span><strong>Requested Delivery Date:</strong> @Model.RequestedDeliveryDate.Value.ToString("dd MMMM yyyy")<br /></span>
            }
        </div>
    </div>
</div>

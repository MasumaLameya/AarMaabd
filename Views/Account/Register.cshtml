@model AarMaabd.ViewModels.RegisterViewModel
@{
    ViewData["Title"] = "Create Account - AarMaabd";
}

<div class="container py-5" style="max-width: 580px;">
    <div class="p-4 p-md-5 bg-white rounded-4 border shadow-sm">
        <div class="text-center mb-4">
            <img src="~/images/branding/logo.jpg" alt="AarMaabd Logo" class="brand-logo-img mx-auto mb-2" style="width: 58px; height: 58px;" />
            <h1 class="h3 fw-bold" style="color: var(--brand-rose);">Join AarMaabd Family</h1>
            <p class="text-muted small">Create an account for personalized shopping & order tracking</p>
        </div>

        @if (!string.IsNullOrEmpty(Model.ReturnUrl) && Model.ReturnUrl.Contains("Checkout", StringComparison.OrdinalIgnoreCase))
        {
            <div class="alert alert-warning border-0 rounded-3 small mb-4 text-center">
                <i class="bi bi-shield-lock-fill me-1"></i>
                <strong>Create your account to complete your order seamlessly.</strong>
            </div>
        }

        <form asp-action="Register" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="ReturnUrl" />

            <div class="row g-3">
                <div class="col-12">
                    <label asp-for="FullName" class="form-label small fw-bold text-uppercase"></label>
                    <input asp-for="FullName" class="form-control rounded-3" placeholder="e.g. Farhana Sultana" />
                    <span asp-validation-for="FullName" class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="Email" class="form-label small fw-bold text-uppercase"></label>
                    <input asp-for="Email" class="form-control rounded-3" placeholder="you@example.com" />
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="PhoneNumber" class="form-label small fw-bold text-uppercase"></label>
                    <input asp-for="PhoneNumber" class="form-control rounded-3" placeholder="01712345678" />
                    <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="Division" class="form-label small fw-bold text-uppercase"></label>
                    <select asp-for="Division" class="form-select rounded-3">
                        <option value="Dhaka">Dhaka</option>
                        <option value="Chittagong">Chittagong</option>
                        <option value="Sylhet">Sylhet</option>
                        <option value="Rajshahi">Rajshahi</option>
                        <option value="Khulna">Khulna</option>
                        <option value="Barisal">Barisal</option>
                        <option value="Rangpur">Rangpur</option>
                        <option value="Mymensingh">Mymensingh</option>
                    </select>
                </div>

                <div class="col-md-6">
                    <label asp-for="District" class="form-label small fw-bold text-uppercase"></label>
                    <input asp-for="District" class="form-control rounded-3" placeholder="e.g. Dhaka" />
                </div>

                <div class="col-md-6">
                    <label asp-for="Password" class="form-label small fw-bold text-uppercase"></label>
                    <input asp-for="Password" class="form-control rounded-3" placeholder="••••••••" />
                    <span asp-validation-for="Password" class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="ConfirmPassword" class="form-label small fw-bold text-uppercase"></label>
                    <input asp-for="ConfirmPassword" class="form-control rounded-3" placeholder="••••••••" />
                    <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                </div>
            </div>

            <div asp-validation-summary="ModelOnly" class="alert alert-danger small p-2 rounded-3 mt-3 mb-3"></div>

            <button type="submit" class="btn-aarmaabd w-100 py-2 fs-6 mt-4">
                <i class="bi bi-person-check me-1"></i> Register Account
            </button>
        </form>

        <div class="text-center mt-4 pt-3 border-top small text-muted">
            Already have an account? 
            <a asp-action="Login" asp-route-returnUrl="@Model.ReturnUrl" class="fw-bold" style="color: var(--brand-rose);">Sign In</a>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

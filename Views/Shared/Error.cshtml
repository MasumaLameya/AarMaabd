@model ErrorViewModel
@{
    ViewData["Title"] = "Page Notice";
    var statusCode = ViewBag.StatusCode as int?;
}

<div class="container py-5 text-center" style="max-width: 650px;">
    <div class="mb-4">
        <div class="d-inline-flex align-items-center justify-content-center rounded-circle" style="width: 80px; height: 80px; background-color: var(--brand-blush);">
            <i class="bi bi-exclamation-diamond fs-1" style="color: var(--brand-rose);"></i>
        </div>
    </div>

    @if (statusCode == 404)
    {
        <h1 class="h3 fw-bold mb-2" style="color: var(--brand-rose);">Page Not Found</h1>
        <p class="text-muted mb-4">The page or product you are looking for may have been moved, renamed, or is currently unavailable.</p>
    }
    else
    {
        <h1 class="h3 fw-bold mb-2" style="color: var(--brand-rose);">Something Went Wrong</h1>
        <p class="text-muted mb-4">We encountered an unexpected issue while processing your request. Our engineering team has been notified.</p>
    }

    @if (Model.ShowRequestId)
    {
        <div class="p-2 mb-4 bg-light rounded-3 text-muted small border">
            Reference Incident ID: <code>@Model.RequestId</code>
        </div>
    }

    <div class="d-flex justify-content-center gap-3">
        <a href="/" class="btn-aarmaabd">
            <i class="bi bi-house-door me-1"></i> Return Home
        </a>
        <a href="/Shop" class="btn btn-outline-secondary rounded-pill px-4">
            <i class="bi bi-bag-heart me-1"></i> Browse Catalog
        </a>
    </div>
</div>

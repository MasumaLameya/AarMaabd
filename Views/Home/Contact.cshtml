@{
    ViewData["Title"] = "Contact Support - AarMaabd";
}

<div class="container py-5" style="max-width: 800px;">
    <div class="text-center mb-5">
        <h1 class="display-6 fw-bold" style="color: var(--brand-rose);">Contact AarMaabd</h1>
        <p class="text-muted">We’d love to hear from you! Reach out for orders, queries, or customized craft ideas.</p>
    </div>

    <div class="row g-4">
        <div class="col-md-5">
            <div class="p-4 bg-white rounded-4 border shadow-sm h-100">
                <h4 class="h5 fw-bold mb-3" style="color: var(--brand-rose);">Store Information</h4>
                
                <div class="mb-3">
                    <small class="text-muted text-uppercase fw-bold d-block">Location:</small>
                    <span>Dhanmondi, Dhaka - 1205, Bangladesh</span>
                </div>

                <div class="mb-3">
                    <small class="text-muted text-uppercase fw-bold d-block">Phone / Mobile:</small>
                    <span>+880 1700-000000</span>
                </div>

                <div class="mb-3">
                    <small class="text-muted text-uppercase fw-bold d-block">Email Support:</small>
                    <span>hello@aarmaabd.com</span>
                </div>

                <div class="mb-4">
                    <small class="text-muted text-uppercase fw-bold d-block">Working Hours:</small>
                    <span>10:00 AM – 9:00 PM (Everyday)</span>
                </div>

                <div class="pt-3 border-top">
                    <a href="https://wa.me/8801700000000" target="_blank" class="btn btn-outline-success w-100 rounded-pill fw-semibold">
                        <i class="bi bi-whatsapp me-1"></i> Message on WhatsApp
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-7">
            <div class="p-4 bg-white rounded-4 border shadow-sm">
                <h4 class="h5 fw-bold mb-3" style="color: var(--brand-rose);">Send us a Message</h4>
                
                @if (TempData["MessageSent"] != null)
                {
                    <div class="alert alert-success small rounded-3 p-3">
                        <i class="bi bi-check-circle-fill me-1"></i> Thank you! Your message has been received. We will get back to you shortly.
                    </div>
                }

                <form method="post" onsubmit="event.preventDefault(); showToast('Thank you! Your message has been sent successfully.'); this.reset();">
                    <div class="mb-3">
                        <label class="form-label small fw-bold text-uppercase">Your Name *</label>
                        <input type="text" class="form-control rounded-3" placeholder="Enter your name" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold text-uppercase">Phone / Email *</label>
                        <input type="text" class="form-control rounded-3" placeholder="Contact number or email" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold text-uppercase">Subject *</label>
                        <input type="text" class="form-control rounded-3" placeholder="Order inquiry, Cake lead time, Custom design..." required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold text-uppercase">Message *</label>
                        <textarea rows="4" class="form-control rounded-3" placeholder="Write your message here..." required></textarea>
                    </div>
                    <button type="submit" class="btn-aarmaabd w-100 py-2">
                        <i class="bi bi-send me-1"></i> Send Message
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

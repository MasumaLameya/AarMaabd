@model AarMaabd.ViewModels.ProductDetailsViewModel
@{
    ViewData["Title"] = Model.Product.Name;
}

<div class="container py-4">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb" style="font-size: 0.85rem;">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
            <li class="breadcrumb-item"><a asp-controller="Shop" asp-action="Index">Shop</a></li>
            @if (Model.Product.Category != null)
            {
                <li class="breadcrumb-item"><a href="/Shop?category=@Model.Product.Category.Slug">@Model.Product.Category.Name</a></li>
            }
            <li class="breadcrumb-item active" aria-current="page">@Model.Product.Name</li>
        </ol>
    </nav>

    <!-- Product Main Grid -->
    <div class="row g-4 g-lg-5">
        <!-- Left: Image Gallery -->
        <div class="col-lg-6">
            <div class="bg-white p-3 rounded-4 border shadow-sm mb-3">
                <div class="position-relative overflow-hidden rounded-3 text-center" style="max-height: 520px;">
                    @if (Model.Product.HasDiscount)
                    {
                        <span class="badge-discount position-absolute top-0 start-0 m-3 z-2">
                            @Model.Product.DiscountPercentage% OFF
                        </span>
                    }
                    <img id="mainProductImage" src="@Model.Product.PrimaryImageUrl" alt="@Model.Product.Name" 
                         class="img-fluid rounded-3" style="object-fit: cover; width: 100%; max-height: 500px;" />
                </div>
            </div>

            <!-- Thumbnails if multiple images -->
            @if (Model.Product.Images.Count > 1)
            {
                <div class="d-flex gap-2 overflow-auto pb-2">
                    @foreach (var img in Model.Product.Images)
                    {
                        <img src="@img.ImageUrl" alt="@img.AltText" 
                             class="rounded-3 border thumbnail-img" 
                             style="width: 72px; height: 72px; object-fit: cover; cursor: pointer;"
                             onclick="document.getElementById('mainProductImage').src = this.src;" />
                    }
                </div>
            }
        </div>

        <!-- Right: Product Information & Purchase Options -->
        <div class="col-lg-6">
            <div class="product-info-wrap">
                <span class="badge bg-light text-muted border rounded-pill px-3 py-1 mb-2">
                    @(Model.Product.Category?.Name ?? "Lifestyle")
                </span>

                <h1 class="h2 fw-bold mb-2" style="color: var(--brand-rose);">@Model.Product.Name</h1>
                <div class="d-flex align-items-center gap-3 text-muted small mb-3">
                    <span>SKU: <strong class="text-dark">@Model.Product.SKU</strong></span>
                    <span>•</span>
                    <div class="d-flex align-items-center text-warning">
                        @for (int i = 1; i <= 5; i++)
                        {
                            <i class="bi @(i <= Model.AverageRating ? "bi-star-fill" : "bi-star")"></i>
                        }
                        <span class="ms-1 text-dark fw-bold">@Model.AverageRating</span>
                        <span class="text-muted ms-1">(@Model.TotalReviewsCount reviews)</span>
                    </div>
                </div>

                <!-- Price Box -->
                <div class="p-3 rounded-3 mb-4 d-flex align-items-baseline gap-3" style="background-color: var(--brand-blush-light); border: 1px solid var(--border-soft);">
                    <span class="fs-2 fw-bold" style="color: var(--brand-rose);">৳@Model.Product.CurrentEffectivePrice.ToString("N0")</span>
                    @if (Model.Product.HasDiscount)
                    {
                        <span class="text-muted text-decoration-line-through fs-5">৳@Model.Product.Price.ToString("N0")</span>
                        <span class="badge bg-danger rounded-pill">Save ৳@((Model.Product.Price - Model.Product.CurrentEffectivePrice).ToString("N0"))</span>
                    }
                </div>

                <!-- Short description -->
                <p class="text-muted mb-4">@Model.Product.ShortDescription</p>

                <!-- Stock / Lead Time status -->
                <div class="mb-4">
                    @if (Model.Product.ProductType == AarMaabd.Models.ProductType.FoodPerishable || Model.Product.ProductType == AarMaabd.Models.ProductType.PreOrder)
                    {
                        <div class="d-flex align-items-center gap-2 text-primary small">
                            <i class="bi bi-clock-history fs-5 text-warning"></i>
                            <span>Freshly prepared to order. Preparation lead time: <strong>@(Model.Product.PreparationLeadDays > 0 ? Model.Product.PreparationLeadDays : 1) day(s)</strong>.</span>
                        </div>
                    }
                    else if (Model.Product.StockQuantity > 0)
                    {
                        <div class="d-flex align-items-center gap-2 text-success small">
                            <i class="bi bi-check-circle-fill fs-5"></i>
                            <span>In Stock (<strong>@Model.Product.StockQuantity units</strong> available)</span>
                        </div>
                    }
                    else
                    {
                        <div class="d-flex align-items-center gap-2 text-danger small">
                            <i class="bi bi-x-circle-fill fs-5"></i>
                            <span>Currently Out of Stock</span>
                        </div>
                    }
                </div>

                <!-- Variants selection if available -->
                @if (Model.Product.Variants.Any())
                {
                    <div class="mb-3">
                        <label for="variantSelect" class="form-label fw-bold small text-uppercase">Select Option:</label>
                        <select id="variantSelect" class="form-select rounded-pill">
                            @foreach (var variant in Model.Product.Variants)
                            {
                                <option value="@variant.Id" data-price="@variant.AdditionalPrice">
                                    @variant.VariantName @(variant.AdditionalPrice > 0 ? $"(+৳{variant.AdditionalPrice:N0})" : "")
                                </option>
                            }
                        </select>
                    </div>
                }

                <!-- Available Colors / Flavors Display -->
                @if (!string.IsNullOrEmpty(Model.Product.AvailableFlavors))
                {
                    <div class="mb-3">
                        <span class="fw-bold small text-uppercase text-muted d-block mb-1">Available Flavors:</span>
                        <span class="badge bg-white text-dark border me-1">@Model.Product.AvailableFlavors</span>
                    </div>
                }
                @if (!string.IsNullOrEmpty(Model.Product.AvailableSizes))
                {
                    <div class="mb-3">
                        <span class="fw-bold small text-uppercase text-muted d-block mb-1">Size / Weight:</span>
                        <span class="badge bg-white text-dark border me-1">@Model.Product.AvailableSizes</span>
                    </div>
                }

                <!-- Customization Note Input -->
                <div class="mb-4">
                    <label for="customNote" class="form-label fw-bold small text-uppercase text-muted">
                        Personalization / Message (Optional):
                    </label>
                    <input type="text" id="customNote" class="form-control rounded-3" 
                           placeholder="e.g. Initial letter 'A', name on cake, custom color request..." maxlength="200" />
                </div>

                <!-- Quantity & Action Buttons -->
                <div class="d-flex gap-3 align-items-center mb-4 flex-wrap">
                    <div class="d-flex align-items-center border rounded-pill bg-white px-2 py-1" style="border-color: var(--border-soft) !important;">
                        <button type="button" class="btn btn-sm btn-link text-dark text-decoration-none" onclick="adjustQty(-1)"><i class="bi bi-dash"></i></button>
                        <input type="number" id="purchaseQty" value="1" min="1" max="@Model.Product.StockQuantity" oninput="if(this.value < 1) this.value = 1;" class="form-control form-control-sm border-0 text-center fw-bold" style="width: 45px;" />
                        <button type="button" class="btn btn-sm btn-link text-dark text-decoration-none" onclick="adjustQty(1)"><i class="bi bi-plus"></i></button>
                    </div>

                    <button type="button" class="btn-aarmaabd flex-grow-1" onclick="handleAddToCart(false)">
                        <i class="bi bi-bag-plus"></i> Add to Cart
                    </button>

                    <button type="button" class="btn-aarmaabd-gold flex-grow-1" onclick="handleAddToCart(true)">
                        <i class="bi bi-lightning-charge"></i> Buy Now
                    </button>
                </div>

                <!-- Product Specifications Accordion -->
                <div class="accordion accordion-flush border rounded-4 bg-white shadow-sm overflow-hidden" id="productSpecsAccordion">
                    <div class="accordion-item">
                        <h2 class="accordion-header">
                            <button class="accordion-button collapsed fw-bold text-dark" type="button" data-bs-toggle="collapse" data-bs-target="#descCollapse">
                                <i class="bi bi-info-circle me-2 text-muted"></i> Full Description & Details
                            </button>
                        </h2>
                        <div id="descCollapse" class="accordion-collapse collapse show">
                            <div class="accordion-body text-muted small">
                                @Model.Product.Description
                            </div>
                        </div>
                    </div>

                    @if (!string.IsNullOrEmpty(Model.Product.Ingredients))
                    {
                        <div class="accordion-item">
                            <h2 class="accordion-header">
                                <button class="accordion-button collapsed fw-bold text-dark" type="button" data-bs-toggle="collapse" data-bs-target="#ingredCollapse">
                                    <i class="bi bi-egg me-2 text-muted"></i> Ingredients & Allergen Information
                                </button>
                            </h2>
                            <div id="ingredCollapse" class="accordion-collapse collapse">
                                <div class="accordion-body text-muted small">
                                    @Model.Product.Ingredients
                                </div>
                            </div>
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(Model.Product.CareInstructions))
                    {
                        <div class="accordion-item">
                            <h2 class="accordion-header">
                                <button class="accordion-button collapsed fw-bold text-dark" type="button" data-bs-toggle="collapse" data-bs-target="#careCollapse">
                                    <i class="bi bi-hand-thumbs-up me-2 text-muted"></i> Care & Washing Instructions
                                </button>
                            </h2>
                            <div id="careCollapse" class="accordion-collapse collapse">
                                <div class="accordion-body text-muted small">
                                    @Model.Product.CareInstructions
                                </div>
                            </div>
                        </div>
                    }

                    <div class="accordion-item">
                        <h2 class="accordion-header">
                            <button class="accordion-button collapsed fw-bold text-dark" type="button" data-bs-toggle="collapse" data-bs-target="#shippingCollapse">
                                <i class="bi bi-truck me-2 text-muted"></i> Delivery Zones & Shipping Information
                            </button>
                        </h2>
                        <div id="shippingCollapse" class="accordion-collapse collapse">
                            <div class="accordion-body text-muted small">
                                <strong>Delivery Area:</strong> Inside Dhaka City Only (৳70). Delivered within 24–48 hours.<br />
                                <strong>Free Delivery:</strong> On all orders above ৳2,500.<br />
                                <span class="text-secondary fst-italic">* Note: Outside Dhaka shipping is currently unavailable. We deliver exclusively within Dhaka.</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Customer Reviews Section -->
    <div class="mt-5 pt-4 border-top">
        <div class="row g-4">
            <div class="col-lg-5">
                <div class="p-4 bg-white rounded-4 border shadow-sm">
                    <h3 class="h4 mb-3" style="color: var(--brand-rose);">Write a Verified Review</h3>
                    <form asp-controller="Products" asp-action="AddReview" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="productId" value="@Model.Product.Id" />

                        <div class="mb-3">
                            <label class="form-label small fw-bold">Your Name *</label>
                            <input type="text" name="customerName" class="form-control rounded-3" required 
                                   value="@(User.Identity?.Name ?? "")" placeholder="Enter your name" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label small fw-bold">Rating *</label>
                            <select name="rating" class="form-select rounded-3">
                                <option value="5">⭐⭐⭐⭐⭐ (5/5 Excellent)</option>
                                <option value="4">⭐⭐⭐⭐ (4/5 Very Good)</option>
                                <option value="3">⭐⭐⭐ (3/5 Average)</option>
                                <option value="2">⭐⭐ (2/5 Needs Improvement)</option>
                                <option value="1">⭐ (1/5 Poor)</option>
                            </select>
                        </div>

                        <div class="mb-3">
                            <label class="form-label small fw-bold">Your Experience / Feedback *</label>
                            <textarea name="comment" rows="3" class="form-control rounded-3" required 
                                      placeholder="Share what you loved about this handmade piece..."></textarea>
                        </div>

                        <button type="submit" class="btn-aarmaabd w-100">Submit Review</button>
                    </form>
                </div>
            </div>

            <div class="col-lg-7">
                <h3 class="h4 mb-3" style="color: var(--brand-rose);">Customer Feedback (@Model.TotalReviewsCount)</h3>
                @if (!Model.Reviews.Any())
                {
                    <div class="p-4 text-center bg-white rounded-4 border text-muted">
                        <i class="bi bi-chat-heart fs-2 mb-2 d-block text-warning"></i>
                        No customer reviews yet. Be the first to share your experience with this product!
                    </div>
                }
                else
                {
                    <div class="d-flex flex-column gap-3">
                        @foreach (var rev in Model.Reviews)
                        {
                            <div class="p-3 bg-white rounded-4 border shadow-sm">
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <strong class="text-dark">@rev.CustomerName</strong>
                                    <span class="text-muted small">@rev.CreatedAtUtc.ToLocalTime().ToString("dd MMM yyyy")</span>
                                </div>
                                <div class="text-warning small mb-2">
                                    @for (int i = 1; i <= 5; i++)
                                    {
                                        <i class="bi @(i <= rev.Rating ? "bi-star-fill" : "bi-star")"></i>
                                    }
                                </div>
                                <p class="text-muted small mb-0">@rev.Comment</p>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Related Products -->
    @if (Model.RelatedProducts.Any())
    {
        <div class="mt-5 pt-4">
            <h3 class="h4 mb-4" style="color: var(--brand-rose);">You May Also Love</h3>
            <div class="row g-3 g-md-4">
                @foreach (var rel in Model.RelatedProducts)
                {
                    <div class="col-6 col-md-3">
                        <div class="product-card">
                            <div class="product-img-wrap">
                                <a href="/product/@rel.Slug">
                                    <img src="@rel.PrimaryImageUrl" alt="@rel.Name" loading="lazy" />
                                </a>
                            </div>
                            <div class="product-body">
                                <h4 class="product-title">
                                    <a href="/product/@rel.Slug">@rel.Name</a>
                                </h4>
                                <div class="product-price-row">
                                    <span class="product-current-price">৳@rel.CurrentEffectivePrice.ToString("N0")</span>
                                </div>
                                <button type="button" class="btn-add-to-cart" onclick="quickAddToCart(@rel.Id, this)">
                                    <i class="bi bi-bag-plus"></i> Add to Cart
                                </button>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    }
</div>

@section Scripts {
    <script>
        function adjustQty(amount) {
            const qtyInput = document.getElementById('purchaseQty');
            let current = parseInt(qtyInput.value) || 1;
            current += amount;
            if (current < 1) current = 1;
            qtyInput.value = current;
        }

        async function handleAddToCart(isBuyNow) {
            const qty = parseInt(document.getElementById('purchaseQty').value) || 1;
            const note = document.getElementById('customNote')?.value || '';
            const variantSelect = document.getElementById('variantSelect');
            const variantId = variantSelect ? parseInt(variantSelect.value) : null;

            try {
                const response = await fetch('/Cart/AddToCart', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        productId: @Model.Product.Id,
                        quantity: qty,
                        variantId: variantId,
                        customizationNote: note
                    })
                });
                const data = await response.json();
                if (data.success) {
                    updateCartCountBadge();
                    if (isBuyNow) {
                        window.location.href = '/Checkout';
                    } else {
                        showToast('Item added to cart! 🛍️');
                    }
                } else {
                    showToast(data.message, true);
                }
            } catch (e) {
                showToast('Failed to add item to cart', true);
            }
        }
    </script>
}
